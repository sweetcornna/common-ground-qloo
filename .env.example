# Copy to .env. Never commit or paste credentials into chat.
# Offline demo works without any key. Live mode never falls back to demo.
QLOO_API_KEY=
QLOO_BASE_URL=https://api.qloo.com
PORT=3001
# Operator safety cap, not an official Qloo quota. Counts retries too; one process.
QLOO_MAX_CALLS_PER_MINUTE=30
# Overall server request deadline; browser planning deadline is 50 seconds.
REQUEST_TIMEOUT_MS=45000
